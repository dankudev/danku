{
  "name": "@dankudev/danku",
  "version": "0.0.0",
  "description": "Create danku projects and deploy them: infrastructure as TypeScript, without a state file.",
  "keywords": [
    "cloudflare",
    "create",
    "danku",
    "infrastructure-as-code",
    "sveltekit",
    "typescript",
    "vite-plus"
  ],
  "homepage": "https://github.com/dankudev/danku/tree/main/packages/danku#readme",
  "bugs": {
    "url": "https://github.com/dankudev/danku/issues"
  },
  "license": "MIT",
  "author": "Daniil Kubarenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dankudev/danku.git",
    "directory": "packages/danku"
  },
  "bin": {
    "danku": "./bin/danku.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./deploy/cloudflare": "./dist/deploy/cloudflare.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "openapi": "kubb generate",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@kubb/parser-ts": "catalog:",
    "@kubb/plugin-fetch": "catalog:",
    "@kubb/plugin-ts": "catalog:",
    "@types/node": "catalog:",
    "commander": "catalog:",
    "kubb": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "inlinedDependencies": {
    "commander": "15.0.0"
  }
}
